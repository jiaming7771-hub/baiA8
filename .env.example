# ============================================================
# CRYPTO PULSE · 环境变量模板
# 复制到项目根目录：cp .env.example .env
# 然后填入真实值。切勿将 .env / 私钥 / RPC Key 提交到 Git。
# ============================================================

# ---------- Solana 实盘钱包（Pump.fun 链上签名）----------
# 任选其一（优先级：WALLET_PRIVATE_KEY > SOLANA_PRIVATE_KEY）
# 格式：Base58 字符串，或 JSON 字节数组 [1,2,...,64]
WALLET_PRIVATE_KEY=
SOLANA_PRIVATE_KEY=

# Helius / 其他主网 RPC（完整 URL，含 api-key 查询参数亦可）
# 示例：https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ---------- Pump.fun 实盘开关与硬风控 ----------
# 0=实盘；1=纸面模拟。模板默认安全模式；实盘还必须 PUMP_LIVE_CONFIRM=1
PUMP_DRY_RUN=1
PUMP_LIVE_CONFIRM=0
PUMP_DEMO_SCAN=0
PUMP_BANKROLL_SOL=10

# 滑点：入场严、出场宽。HARD_MIN=100bps；入场默认 250bps，出场/常规 500bps
# （旧 HARD_MIN=500 是「一买就亏 5%」根因——Jupiter 被允许比报价再贵 5%）
PUMP_MAX_SLIPPAGE_BPS=500
PUMP_ENTRY_MAX_SLIPPAGE_BPS=300
# 单笔仓位：默认 1% 权益，硬顶 2%；单笔 SOL 夹在 0.02~0.04
PUMP_POSITION_PCT=0.01
PUMP_MIN_POS_SOL=0.02
PUMP_MAX_POS_SOL=0.04
# 权益回撤熔断（相对峰值），默认 15%
PUMP_DRAWDOWN_HALT=0.15
# 绝对亏损熔断（SOL）
PUMP_ABS_LOSS_HALT_SOL=0.6

# ---------- 策略模式 ----------
# momentum=顺势接力（默认）；dip=旧捡尸（已废弃，仅兼容）
PUMP_STRATEGY_MODE=momentum
STRATEGY_MODE=momentum
# 双轨：A 短线爆发 + B 老盘蓄势（PUMP_TRACK_B=0 可关 B）
PUMP_TRACK_B=1
# —— 轨道 A ——
PUMP_A_AGE_MIN=45
PUMP_A_AGE_MAX=720
PUMP_A_REBOUND_MIN=0.15
PUMP_A_REBOUND_MAX=0.80
PUMP_A_PULLBACK_MAX=0.25
PUMP_A_LIQ_MIN=25
PUMP_A_MIN_TX_M5=10
PUMP_A_MIN_VOL_M5=3
PUMP_A_BUY_SELL=1.15
PUMP_A_HARD_STOP=0.22
PUMP_A_TP1=0.25
PUMP_A_TP1_SELL=0.50
PUMP_A_TRAIL=0.20
PUMP_A_TIME_STOP=12
# —— 轨道 B ——
PUMP_B_AGE_MIN=45
PUMP_B_AGE_MAX=1440
PUMP_B_LIQ_MIN=25
PUMP_B_PULLBACK_MAX=0.15
PUMP_B_MIN_TX_M5=15
PUMP_B_MIN_VOL_M5=8
PUMP_B_BUY_SELL=1.15
PUMP_B_VOL_SPIKE=1.6
PUMP_B_HARD_STOP=0.22
PUMP_B_TP1=0.25
PUMP_B_TP1_SELL=0.50
PUMP_B_TRAIL=0.12
PUMP_B_TIME_STOP=45
# 延伸段加严（A）+ 老盘暴力豁免
PUMP_REBOUND_STRICT_FROM=0.40
PUMP_REBOUND_STRICT_BS=2.0
PUMP_REBOUND_STRICT_PB=0.08
# 砸盘残废一票否决：回撤绝对值 >30%
PUMP_CRASH_PULLBACK_MAX=0.35
# 仿盘 Symbol 黑名单（逗号分隔）；看板主键永远是 mint
# PUMP_CLONE_SYMBOL_BLOCKLIST=BTC,ETH,SOL,...
PUMP_MOMENTUM_STREAK=1
PUMP_AGE_EXEMPT_VOL=100
PUMP_AGE_EXEMPT_TX=200
PUMP_AGE_EXEMPT_BS=3.0
PUMP_ATH_MAX_MULTIPLIER=20
# 旧捡尸兼容参数（仅 dip 模式）
PUMP_ATH_DROP=0.40
PUMP_ATH_DROP_MAX=0.80
PUMP_PANIC_RATIO=1.2
PUMP_WHALE_DUMP=0.40

# 紧急逃生滑点上限（bps，默认 30%）；死盘早砍仅轨道 A
PUMP_URGENT_SLIPPAGE_BPS_MAX=3000
PUMP_DEAD_CUT_SEC=105
PUMP_DEAD_CUT_PNL=0.03
PUMP_DEAD_CUT_VOL_RATIO=0.55
# 扫描间隔（候选发现）；持仓链上报价独立为秒级
PUMP_SCAN_INTERVAL=25
PUMP_MARK_INTERVAL=2
# RPC / 交易确认超时与重试
PUMP_RPC_TIMEOUT_SEC=20
PUMP_TX_CONFIRM_TIMEOUT_SEC=60
PUMP_RPC_MAX_RETRIES=3
# 出境代理（Helius RPC / Jupiter / 行情源被墙时必配，如 Clash）
PUMP_HTTP_PROXY=http://127.0.0.1:7897
# 可选：显式 Solana WSS（默认由 SOLANA_RPC_URL https→wss 推导）
# SOLANA_WSS_URL=

# ---------- CEX 双子星实盘（可选）----------
LIVE_EXCHANGE=okx
LIVE_SANDBOX=1
LIVE_TRADING=0
LIVE_CONFIRM_NO_WITHDRAW=0
OKX_API_KEY=
OKX_SECRET=
OKX_PASSPHRASE=
BINANCE_API_KEY=
BINANCE_SECRET=

# 影子交易：真行情 + 虚拟成交（禁用 Jupiter）
SHADOW_MODE=true
SHADOW_SIZE_SOL=1.0
# 单边影子滑点（bps），另计 DEX fee + gas
SHADOW_SLIPPAGE_BPS=300

# ---------- 小资金实盘 Micro-Live（压力测试）----------
# 激活条件（三项同时满足，且 SHADOW_MODE 会被强制关闭）：
#   PUMP_MICRO_LIVE=1 + PUMP_DRY_RUN=0 + PUMP_LIVE_CONFIRM=1
PUMP_MICRO_LIVE=0
# 单笔真实买入金额（SOL），建议 0.05~0.1，代码硬顶 0.10
PUMP_LIVE_SIZE_SOL=0.05
# 钱包租金/底仓保护：ATA 租金 ≈0.00203 SOL；买入后至少留 0.05；总余额地板 0.2
PUMP_ATA_RENT_SOL=0.00203928
PUMP_WALLET_RESERVE_SOL=0.05
PUMP_WALLET_MIN_SOL=0.2
# 出场报价兜底：报价可兑现 SOL 低于盘口估值的 (1-该值) 时判定抽池，非保命单放弃卖出
PUMP_EXIT_MAX_IMPACT_PCT=0.35
# 买入前链上安全审计（防貔貅/增发/撤池）：1=开启；mint/freeze 权限须放弃 + 池归属安全程序
PUMP_SAFETY_CHECK=1
# 影子模式是否也跑安全审计（默认关，省 RPC）
PUMP_SAFETY_IN_SHADOW=0
# 安全审计结果缓存秒数
PUMP_SAFETY_CACHE_TTL_SEC=300
# 筹码集中度：前10大非流动性持仓占供应量 >40% 拦截；流通盘内 >70% 也拦截
PUMP_HOLDER_TOP_N=10
PUMP_HOLDER_TOP10_MAX_PCT=0.35
PUMP_HOLDER_CIRC_MAX_PCT=0.70
PUMP_HOLDER_CACHE_TTL_SEC=120
# 捆绑/多钱包(Sybil)控盘：把 Token 账户解析到控制人钱包并按 owner 聚合；
# 再对前 N 大控制人做「共同资金源」聚类，同一母钱包喂出的多个小号合计占供应量
# 超阈值即判定捆绑控盘并拦截（绕过单钱包集中度的分仓手法）
PUMP_BUNDLE_CHECK=1
PUMP_BUNDLE_MAX_PCT=0.35
PUMP_BUNDLE_PROBE_OWNERS=12
# 同 slot 出生聚类（捆绑发射铁证）：前 N 大持仓的 token 账户若 ≥K 个诞生在同一个
# slot 且合计仍持有 > 阈值供应量 → 拦截。Bubsem 验尸：开盘 slot 9 钱包吃 40.6%
PUMP_BUNDLE_SLOT_MIN_WALLETS=3
PUMP_BUNDLE_SLOT_MAX_PCT=0.15
# 池子成交等额齐动手（CXMT）：不看前20——扫池子最近成交，同 slot/近窗 ≥K 个钱包买卖量几乎相等 → 拒买
PUMP_FARM_POOL_TX_CHECK=1
PUMP_FARM_POOL_TX_LIMIT=100
PUMP_FARM_POOL_TX_PARSE=36
PUMP_FARM_POOL_MIN_WALLETS=8
PUMP_FARM_POOL_SIZE_TOL=0.02
PUMP_FARM_POOL_MIN_PCT=0.00005
PUMP_FARM_POOL_MAX_PCT=0.01
# 早期大户熔断默认关（做不到 100% 准，误砍多于救命）
PUMP_EARLY_WHALE_CHECK=0
PUMP_PANIC_STOP_PCT=0.30
PUMP_HARD_STOP_CONFIRM_SEC=3
PUMP_EARLY_FADE=1
PUMP_EARLY_FADE_SEC=45
PUMP_EARLY_FADE_MAX_PEAK=0.03
PUMP_EARLY_FADE_MIN_LOSS=0.08
PUMP_EARLY_WHALE_WINDOW_SEC=180
PUMP_EARLY_WHALE_DUMP_PCT=0.25
PUMP_EARLY_WHALE_POLL_SEC=5
PUMP_EARLY_WHALE_GRACE_SEC=30
PUMP_EARLY_WHALE_STRIKES=2
PUMP_EARLY_WHALE_MIN_PNL_DROP=-0.08
PUMP_EARLY_WHALE_COOLDOWN_SEC=7200
# 开仓前往返报价：买→立刻反手卖，回收率 <90% 或买入冲击过大 → 拦截
PUMP_ROUNDTRIP_CHECK=1
PUMP_ROUNDTRIP_MIN_RECOVERY=0.90
PUMP_ENTRY_MAX_IMPACT_PCT=0.03
PUMP_ENTRY_DIRECT_ROUTES=1
# 卖不出：非保命单也重试+路由切换；全路由坍塌强制 salvage；假涨 TP 改全仓逃生
PUMP_EXIT_SELL_RETRIES=4
PUMP_EXIT_SELL_RETRY_NON_URGENT=1
PUMP_EXIT_FORCE_SALVAGE=1
PUMP_EXIT_EXPECT_COST_FLOOR=0.55
PUMP_ILLIQUID_FORCE_SELL_SEC=25
# 持仓期金库 SOL 相对开仓骤降 ≥40% → 立刻抽池逃生（CXMT：砸干 SOL 侧时旧逻辑沿用假 mark）
PUMP_VAULT_DRAIN_DROP_PCT=0.40
PUMP_TP1_REALIZABLE_MIN=0.75
PUMP_EXIT_MAX_IMPACT_PCT=0.40
# 买前确认窄带：跌>3% / 涨>5% 都放弃；看板→链上向上偏离≥8% 放弃
PUMP_ENTRY_CONFIRM_SEC=8
PUMP_ENTRY_CONFIRM_MAX_DROP=0.03
PUMP_ENTRY_CONFIRM_MAX_RISE=0.05
PUMP_ENTRY_BOARD_CHAIN_DRIFT_MAX=0.08
PUMP_ENTRY_QUOTE_MID_GAP_MAX=0.02
PUMP_ENTRY_PRE_SEND_RISE_MAX=0.015
PUMP_ENTRY_SLIP_OVERSHOOT_COOLDOWN_SEC=1800
# 进场质量：最低分 + ATH 回撤上限（残盘禁买）
PUMP_ENTRY_MIN_SCORE=55
PUMP_ENTRY_ATH_DROP_MAX=0.35
# 同币亏损硬封禁：亏1次封2h；同日亏≥2次封24h（强反转不可解）
PUMP_MINT_LOSS_BAN_1_SEC=7200
PUMP_MINT_LOSS_BAN_2_SEC=86400
# 同名 Symbol 冷却：防换 mint 连环开
PUMP_SYMBOL_COOLDOWN_SEC=21600
PUMP_SYMBOL_LOSS_BAN_SEC=43200
# 实盘买过一次的 ticker 永久禁买，换 mint 也不再进
PUMP_SYMBOL_PERMANENT_BAN=1
# 选币/买币结构优化：真实K线硬依赖 + 微观结构确认 + 开发者画像
PUMP_ENTRY_REQUIRE_OHLCV=1
PUMP_ENTRY_MIN_STREAK_NO_OHLCV=2
PUMP_ENTRY_FLOW_CONFIRM=1
PUMP_ENTRY_FLOW_MIN_HOLD_TICKS=2
PUMP_CREATOR_BAN=1
PUMP_CREATOR_LOSS_BAN_SEC=86400
PUMP_CREATOR_MAX_DEPLOYS_24H=3
# 防跑路：只买已毕业 pumpswap 池 + 往返预检 2 倍深度
PUMP_ENTRY_GRADUATED_ONLY=1
PUMP_ENTRY_ROUNDTRIP_DEPTH_MULT=2
# 强反转提前解锁默认关（0），防同币连环回踩
PUMP_REENTRY_MAX_RETRY=0
PUMP_REENTRY_STRONG_SEC=600
PUMP_EXIT_COOLDOWN_SEC=1800
# Token-2022 扩展 / 元数据 updateAuthority / 恶名黑名单
PUMP_TOKEN2022_EXT_CHECK=1
PUMP_REQUIRE_REVOKED_UPDATE=1
PUMP_BLACKLIST_WALLETS=
# PUMP_BLACKLIST_FILE=backend/pumpfun/data/blacklist_wallets.txt
# 真实 K 线防插针假反弹 + 行情过旧禁开
PUMP_OHLCV_REBOUND=1
PUMP_OHLCV_LOOKBACK_MIN=30
PUMP_WICK_SPIKE_RATIO=2.5
PUMP_SIGNAL_MAX_AGE_SEC=90
# 优先费：priorityLevel（medium|high|veryHigh）+ 最大 lamports（默认 0.002 SOL）
PUMP_PRIORITY_LEVEL=veryHigh
PUMP_PRIORITY_FEE_MAX_LAMPORTS=2000000
# Jito 小费（lamports）；>0 时改走 Jito tip 而非普通优先费
PUMP_JITO_TIP_LAMPORTS=0
# 止损卖出失败重试：次数与每次抬升滑点步长（bps）
PUMP_EXIT_SELL_RETRIES=4
PUMP_EXIT_SLIP_STEP_BPS=200
# 买入广播失败重试：PumpSwap 创作者费 MissingAccount / 过期区块哈希多为瞬时，
# 换路由重新报价后重试；0=不重试
PUMP_BUY_SEND_RETRIES=2
