# 双子星实盘 · 环境变量模板（复制为 .env 后填入，切勿提交密钥）
# cp simlab/.env.example .env

# --- 交易所选择：okx（默认）| binance ---
LIVE_EXCHANGE=okx

# --- 默认沙盒/测试网：1=开  0=关（生产务必三思）---
LIVE_SANDBOX=1

# --- 真下单总开关：默认 0；只有当你准备好时才设 1 ---
LIVE_TRADING=0

# --- 必须确认：本 API Key 已关闭提现 ---
LIVE_CONFIRM_NO_WITHDRAW=0

# --- Solana 实盘钱包（Pump.fun；切勿提交真实私钥）---
# 优先级：WALLET_PRIVATE_KEY > SOLANA_PRIVATE_KEY
WALLET_PRIVATE_KEY=
# SOLANA_PRIVATE_KEY=
# 示例：https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
PUMP_DRY_RUN=1
PUMP_LIVE_CONFIRM=0
PUMP_DEMO_SCAN=1

# --- OKX（优先）---
OKX_API_KEY=
OKX_SECRET=
OKX_PASSPHRASE=

# --- Binance USDT-M（次选）---
BINANCE_API_KEY=
BINANCE_SECRET=

# --- 极度保守资金参数（硬顶：池≤20%，单笔风险≤1%）---
LIVE_POOL_FRACTION=0.05
LIVE_RISK_PERCENT=0.003
LIVE_MAX_NOTIONAL_FRACTION=0.08
LIVE_MAX_LEVERAGE=2
LIVE_MAX_POSITIONS=3

# --- 仅 hard_pass 前三；设 1 才允许降级备选 ---
LIVE_ALLOW_FALLBACK=0
